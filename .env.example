# 服务配置
APP_NAME=合同审查智能体
APP_VERSION=1.0.0
# 本地运行默认只监听回环地址；Docker Compose 会显式覆盖为 0.0.0.0
HOST=127.0.0.1
PORT=8090
DEBUG=false
LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO

# API
API_PREFIX=/api/v1
# 使用 JSON 数组配置允许的浏览器来源，禁止通配符 + 凭据组合
CORS_ORIGINS=["http://127.0.0.1:8090","http://localhost:8090"]
# 必填：请替换为随机长 Token；留空时受保护 API 返回 503，不会关闭鉴权
API_TOKEN=
AUTH_HEADER_NAME=X-API-Token

# 文件限制
MAX_IMAGE_SIZE=10485760
MAX_DOCUMENT_SIZE=104857600
SEAL_PDF_RENDER_DPI=200

# OCR 网关（扫描页文字识别 / 印章识别）
# 用户打开审查页面不需要 Token；这里是后端调用 OCR 网关时代填的服务端凭证
# 本机示例；不同环境请按实际地址覆盖
OCR_GATEWAY_BASE_URL=http://127.0.0.1:8080
OCR_GATEWAY_API_PREFIX=/api/v1
OCR_GATEWAY_TOKEN=
OCR_GATEWAY_AUTH_HEADER=X-API-Token
OCR_GATEWAY_TIMEOUT_SECONDS=60

# Redis / Celery（与 OCR 网关错开 DB，避免互相覆盖）
# 本机示例；不同环境请整体替换主机地址，并保留 DB 分区
REDIS_URL=redis://localhost:6380/3
CELERY_BROKER_URL=redis://localhost:6380/4
CELERY_RESULT_BACKEND=redis://localhost:6380/5
CELERY_DEFAULT_QUEUE=contract.heavy
CELERY_ENABLE_UTC=true
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true
CELERY_TASK_TRACK_STARTED=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# 异步任务
TASK_PENDING_LIMIT=500
TASK_IDEMPOTENCY_TTL_SECONDS=259200
TASK_STAGE_EVENT_LIMIT=256
TASK_RESULT_TTL_SUCCESS=259200
TASK_RESULT_TTL_FAILED=86400
TASK_EXPIRED_RETENTION_SECONDS=300
TASK_HEARTBEAT_INTERVAL_SECONDS=30
TASK_HEARTBEAT_TIMEOUT_SECONDS=180
TASK_RECONCILE_INTERVAL_SECONDS=60
TASK_CLEANUP_INTERVAL_SECONDS=600
TASK_CLEANUP_BATCH_SIZE=200
TASK_MAX_RETRIES=1
TASK_DLQ_RETENTION_SECONDS=604800
TASK_DLQ_MAX_LEN=1000
TASK_INPUT_DIR=runtime/tasks/input

# 合同审查
CONTRACT_RULES_PATH=data/contract_rules_v0.14.json
CONTRACT_CORE_RULES_PATH=data/contract_core_rules_v0.15.json
# 标准要素字段目录快照；修改后目录指纹变化，会让旧结果无法通过回放校验
CONTRACT_ELEMENT_FIELDS_PATH=data/contract_element_fields_v1.json
CONTRACT_OCR_CONFIDENCE_THRESHOLD=0.0
CONTRACT_REVIEW_ENDPOINT=
CONTRACT_REVIEW_API_KEY=
CONTRACT_REVIEW_MODEL=
CONTRACT_REVIEW_PROVIDER=openai-compatible
CONTRACT_REVIEW_PROMPT_VERSION=contract-review-prompt-v1
CONTRACT_REVIEW_JSON_MODE=false
CONTRACT_SEAL_DETECTION_ENABLED=true
CONTRACT_SEAL_MAX_PAGES=50
CONTRACT_AI_PII_GATE_ENABLED=true
CONTRACT_AI_PII_MODE=block
CONTRACT_PII_SCANNER_VERSION=pii-scanner-0.1.0
CONTRACT_REVIEW_CACHE_ENABLED=true
CONTRACT_REVIEW_CACHE_DIR=runtime/review_cache
# 服务端权威审查结果快照；后置人工动作不信任客户端自带的完整结果
CONTRACT_REVIEW_RESULT_STORE_DIR=runtime/review_results
CONTRACT_REVIEW_TIMEOUT_SECONDS=300
CONTRACT_REVIEW_MODEL_MAX_ATTEMPTS=5
CONTRACT_REVIEW_MODEL_RETRY_BACKOFF_SECONDS=0.25
# 临时 HTTP 状态重试抖动比例与单次退避上限；Retry-After 也受上限约束
CONTRACT_REVIEW_MODEL_RETRY_JITTER_RATIO=0.2
CONTRACT_REVIEW_MODEL_MAX_BACKOFF_SECONDS=30
# 连续临时失败时熔断；冷却后只允许一个 half-open 探针，默认开启
CONTRACT_REVIEW_MODEL_CIRCUIT_BREAKER_ENABLED=true
CONTRACT_REVIEW_MODEL_CIRCUIT_FAILURE_THRESHOLD=3
CONTRACT_REVIEW_MODEL_CIRCUIT_OPEN_TIMEOUT_SECONDS=30
# 阶段 2 进程内 chat 模型共享并发上限与有界等待秒数，默认均为保守值
CONTRACT_REVIEW_MODEL_MAX_CONCURRENCY=1
CONTRACT_REVIEW_MODEL_QUEUE_TIMEOUT_SECONDS=30
# 自适应规则级并发默认关闭；开启前须先完成真实连续审查验收
CONTRACT_REVIEW_MODEL_ADAPTIVE_CONCURRENCY_ENABLED=false
CONTRACT_REVIEW_MODEL_ADAPTIVE_MIN_CONCURRENCY=1
CONTRACT_REVIEW_MODEL_ADAPTIVE_INITIAL_CONCURRENCY=1
CONTRACT_REVIEW_MODEL_ADAPTIVE_MAX_CONCURRENCY=3
CONTRACT_REVIEW_MODEL_ADAPTIVE_TARGET_LATENCY_SECONDS=60
CONTRACT_REVIEW_MODEL_ADAPTIVE_SUCCESS_WINDOW=4
# 单次审查的规则级模型并发上限：默认串行，当前硬上限为 3。
# 语义审查用的是自己那份模型闸门（operation=semantic_review），改这一个值即可生效，
# 不必同时调 CONTRACT_REVIEW_MODEL_MAX_CONCURRENCY。并发度会进入审查缓存身份，
# 改完会按新模式重新审查。
CONTRACT_REVIEW_SEMANTIC_MAX_CONCURRENCY=1
# 通读风险分析的分片并发上限：默认串行，硬上限同语义并发（3）。
# 风险分析用的是自己的模型闸门，改这一个值即可生效，不必同时调
# CONTRACT_REVIEW_MODEL_MAX_CONCURRENCY。并发度会进入审查缓存身份，
# 改完会按新模式重新审查。
CONTRACT_REVIEW_RISK_ANALYSIS_MAX_CONCURRENCY=1
CONTRACT_REVIEW_EMBEDDING_ENDPOINT=
CONTRACT_REVIEW_EMBEDDING_API_KEY=
CONTRACT_REVIEW_EMBEDDING_MODEL=
CONTRACT_REVIEW_EMBEDDING_TIMEOUT_SECONDS=120
# embedding 进程内共享并发上限与有界等待秒数，默认不放大外部请求
CONTRACT_REVIEW_EMBEDDING_MAX_CONCURRENCY=1
CONTRACT_REVIEW_EMBEDDING_QUEUE_TIMEOUT_SECONDS=30
CONTRACT_REVIEW_EMBEDDING_CACHE_DIR=runtime/embedding_cache
CONTRACT_REVIEW_RETRIEVAL_TOP_K=7

# 要素 AI 补全：只补确定性抽取未命中的字段，必须回指候选证据；需同时配置
# CONTRACT_REVIEW_ENDPOINT 才会发起调用，PII 门禁阻止时自动跳过
CONTRACT_ELEMENT_AI_COMPLETION_ENABLED=true
CONTRACT_ELEMENT_AI_COMPLETION_PROMPT_VERSION=contract-element-completion-prompt-v1

# 通读式 AI 风险分析：模型通读合同摘录，补充规则库未覆盖的风险点；每条必须
# 回指候选证据。需同时配置 CONTRACT_REVIEW_ENDPOINT 才会发起调用
CONTRACT_RISK_ANALYSIS_ENABLED=true
CONTRACT_RISK_ANALYSIS_PROMPT_VERSION=contract-risk-analysis-prompt-v1

# 规则引擎库：合同检查标准的可编辑覆盖层（自定义规则 + 停用/删除标记），保存即生效
CONTRACT_CUSTOM_RULES_PATH=data/contract_custom_rules.json

# 可选 OpenTelemetry（安装 uv sync --extra otel 后再开启）
OTEL_ENABLED=false
OTEL_SERVICE_NAME=contract-review-agent
